AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

TELEGRAM_BOT_TOKEN=telegram-bot-token
ADMIN_CHAT_ID=admin-chat-id

# Chargily Pay v2 Configuration
CHARGILY_MODE=live
CHARGILY_PUBLIC_KEY=your_public_key
CHARGILY_SECRET_KEY=your_secret_key

# Cloudflare R2 Storage Configuration
ADMIN_STORAGE_DISK=r2
SELLER_STORAGE_DISK=r2
SUPPLIER_STORAGE_DISK=r2
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_DEFAULT_REGION=auto
R2_BUCKET=your_bucket_name
R2_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=public-url-of-your-bucket
R2_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare for SaaS Configuration (Custom Domains)
CLOUDFLARE_EMAIL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=5
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FALLBACK_ORIGIN=

# Google Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# اختياري للبحث الحي على جوجل والإنترنت (Tavily أو Serper)
TAVILY_API_KEY=