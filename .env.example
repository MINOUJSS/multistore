# Mail driver — uses brevo API transport
MAIL_MAILER=brevo
# From Brevo dashboard > SMTP & API > API Keys
BREVO_API_KEY="your_api_key"
# Sender address — must be verified in Brevo
MAIL_FROM_ADDRESS="your email"
MAIL_FROM_NAME="app name"


